
# ==========================================
# HCDF BACKEND - ENVIRONMENT CONFIGURATION
# ==========================================

# Application
NODE_ENV=development
PORT=5001

# ==========================================
# MYSQL DATABASE CONFIGURATION
# ==========================================

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hcdf_website
DB_USER=hcdf_app
DB_PASSWORD="HCDF123#"
DB_DIALECT=mysql

# ==========================================
# FRONTEND / CORS CONFIGURATION
# ==========================================

FRONTEND_URLS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# ==========================================
# JWT AUTHENTICATION CONFIGURATION
# ==========================================

JWT_ACCESS_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=7

# ==========================================
# COOKIE SECURITY CONFIGURATION
# ==========================================

COOKIE_SECURE=false

# ==========================================
# FIRST SUPER ADMIN BOOTSTRAP
# Temporary values only
# ==========================================

BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=
